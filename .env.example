# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 git 忽略，真实密钥永远不要提交

# ---- 数据库（本机原生 PostgreSQL 16 服务，端口 5432）----
# 首次部署需用超级用户执行一次：
#   CREATE ROLE thesis LOGIN PASSWORD 'thesis_dev_pwd';
#   CREATE DATABASE thesis OWNER thesis ENCODING 'UTF8';

# ---- 后端 ----
APP_ENV=dev
APP_NAME=毕设论文审核系统
APP_HOST=127.0.0.1
APP_PORT=8000
# 填写给 uvicorn 用的 URL；密码含特殊字符时需 URL 编码
DATABASE_URL=postgresql+asyncpg://thesis:thesis_dev_pwd@127.0.0.1:5432/thesis
# 前端开发服务器地址，用 JSON 数组写
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- 文件上传 ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---- 智能体（AI 预审）----
# 总开关：false 时上传/审核等主流程完全不受影响，界面也不出现 AI 内容
AI_ENABLED=false
# mock = 不联网的演示模式（无需 key）；deepseek = 调用 OpenAI 兼容接口
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 真实 key 只写在本机 .env（已被 git 忽略），部署时用服务器环境变量注入
AI_API_KEY=
# 每天最多自动预审多少次，0 表示不限
AI_DAILY_LIMIT=30
# 单次输出上限（tokens）。开题报告约 2500-3000，留 4000 防截断
AI_MAX_TOKENS=6000
# 失败自动重试次数（只重试超时 / 限流 / 输出截断这类"再试一次可能就好"的错误）
AI_RETRY_TIMES=1
# 送入模型的正文上限（字符数）
AI_MAX_CHARS=24000

# ---- 智能审阅服务（外部 HTTP 接口）----
# 总开关：false 时「发起智能审阅」按钮不可用，主流程不受影响
AGENT_ENABLED=false
AGENT_BASE_URL=https://10.96.20.67:9443/api/v1
# 令牌由服务方单独交付，只写在本机 .env，不要提交
AGENT_TOKEN=
# 对方证书是 Caddy 自签且 12 小时一换，本机联调跳过校验；上线换正式证书后设 true
AGENT_VERIFY_TLS=false
# 对方支持的格式；PDF 修复后再把 pdf 加进来
AGENT_SUPPORTED_EXT=docx,png,jpg,jpeg,zip
AGENT_POLL_INTERVAL=10
AGENT_MAX_WAIT_MINUTES=60
AGENT_MAX_FILES=10
AGENT_MAX_FILE_MB=2
